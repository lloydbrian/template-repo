# .env.example — variable NAMES with safe defaults only. This file is committed.
# Copy to .env.dev or .env.test and fill values locally; those files are git-ignored.
# Production values come from the platform's secret store or `podman secret`, never a file.
APP_ENV=dev
LOG_LEVEL=INFO
APP_TITLE="Template Sample App"
APP_VERSION=0.1.0
LOG_JSON=true
HTTP_PORT=8000
# Add project-specific variables below (names only, no real values)
