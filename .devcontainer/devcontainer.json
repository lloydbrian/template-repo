{
  "name": "template-sample-app-dev",
  "build": { "dockerfile": "../.container/Containerfile", "context": "..", "target": "dev" },
  "runArgs": ["--userns=keep-id"],
  "postCreateCommand": "uv sync --locked && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy",
                     "charliermarsh.ruff", "tamasfe.even-better-toml", "ms-toolsai.jupyter"]
    }
  }
}
